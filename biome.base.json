{
  "$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useBlockStatements": "error",
        "noNonNullAssertion": "error"
      }
    }
  },
  "formatter": {
    "enabled": false
  }
}
