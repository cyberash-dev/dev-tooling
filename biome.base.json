{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 80,
            "skipBlankLines": true
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 7
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useBlockStatements": "error",
        "noNonNullAssertion": "error"
      }
    }
  },
  "formatter": {
    "enabled": false
  }
}
