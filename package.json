{
	"name": "@cyberash-dev/dev-tooling",
	"version": "5.0.0",
	"description": "Shareable ESLint + Prettier config (incl. a comment policy) for TypeScript/JavaScript projects.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyberash-dev/dev-tooling.git"
	},
	"keywords": [
		"eslint",
		"eslint-config",
		"prettier",
		"prettier-config",
		"comments",
		"comment-policy",
		"linter",
		"code-style",
		"typescript"
	],
	"files": [
		"eslint.base.mjs",
		"prettier.base.json",
		"eslint-rules",
		"skills",
		"AGENTS.md"
	],
	"scripts": {
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "node tests/run-all.mjs",
		"prepublishOnly": "npm test"
	},
	"dependencies": {
		"@eslint/js": "9.39.4",
		"eslint-config-prettier": "9.1.2",
		"eslint-plugin-comment-policy": "0.2.0",
		"eslint-plugin-max-properties-per-class": "1.0.1",
		"globals": "15.15.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.60.0"
	},
	"peerDependencies": {
		"eslint": ">=9",
		"prettier": ">=3"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"engines": {
		"node": ">=20"
	}
}
